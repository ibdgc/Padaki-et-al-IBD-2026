Bootstrap: docker
From: ubuntu:20.04

%labels
    AUTHOR YourName
    Version v1.0
    Description Container for BGE genome analysis workflows

%environment
    export PATH="/usr/local/bin:$PATH"
    export LC_ALL=C

%post
    # Install basic dependencies
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        perl \
        wget \
        gzip \
        tar \
        curl \
        build-essential
    rm -rf /var/lib/apt/lists/*

    # Install PLINK 2
    wget https://s3.amazonaws.com/plink2-assets/alpha6/plink2_linux_avx2_20250129.zip && \
    unzip plink2_linux_avx2_20250129.zip && \
    mv plink2 /usr/local/bin/ && \
    rm plink2_linux_avx2_20250129.zip

    # Create directories
    mkdir -p /app

%files
    workflows/add_rs_to_pvar.pl /usr/local/bin/
    workflows/make_bge_exonic_list.pl /usr/local/bin/
    workflows/unpacking.sh /usr/local/bin/

%post
    # Make scripts executable
    chmod +x /usr/local/bin/add_rs_to_pvar.pl
    chmod +x /usr/local/bin/make_bge_exonic_list.pl
    chmod +x /usr/local/bin/unpacking.sh

%runscript
    exec "$@"

